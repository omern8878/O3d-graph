{
  "name": "@omernach/o3d-graph",
  "version": "0.1.0",
  "description": "Interactive 2D/3D force-directed network graphs on the @omernach/o3d WebGPU renderer: Barnes-Hut physics, picking, dragging, labels and camera controls, zero-copy into WASM.",
  "license": "MIT",
  "author": "omernach",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omern8878/O3d-graph.git"
  },
  "homepage": "https://github.com/omern8878/O3d-graph#readme",
  "bugs": {
    "url": "https://github.com/omern8878/O3d-graph/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "graph",
    "network",
    "force-directed",
    "barnes-hut",
    "octree",
    "webgpu",
    "webassembly",
    "wasm",
    "3d",
    "visualization",
    "o3d"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p demo/tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run check",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "demo:typecheck": "tsc -p demo/tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build && npm run demo:build"
  },
  "peerDependencies": {
    "@omernach/o3d": "^1.0.1"
  },
  "devDependencies": {
    "@omernach/o3d": "^1.0.1",
    "@webgpu/types": "^0.1.74",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  }
}
